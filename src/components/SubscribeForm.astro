---
import { NEWSLETTER } from '../consts';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class:list={['border line bg-surface', compact ? 'p-6' : 'p-8 sm:p-10']}>
  <p class="meta-label">{NEWSLETTER.name}</p>
  <p class:list={['mt-3 font-serif font-semibold leading-snug', compact ? 'text-xl' : 'text-2xl sm:text-3xl']}>
    {NEWSLETTER.pitch}
  </p>
  <form
    action={NEWSLETTER.action}
    method="post"
    target="_blank"
    class="mt-6 flex flex-col gap-3 sm:flex-row"
  >
    <label class="sr-only" for={`email-${compact ? 'c' : 'f'}`}>Email</label>
    <input
      id={`email-${compact ? 'c' : 'f'}`}
      type="email"
      name="email"
      required
      placeholder="you@example.com"
      autocomplete="email"
      class="field"
    />
    <button type="submit" class="btn-accent justify-center">Subscribe</button>
  </form>
  <p class="mt-4 text-[0.8rem] leading-relaxed text-muted">
    Free, one email a week, one-click unsubscribe. Your address is never shared with third parties.
  </p>
</div>
