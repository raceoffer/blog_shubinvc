---
import { AUTHOR, NAV } from '../consts';
import Arrow from './Arrow.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t line">
  <div class="mx-auto grid max-w-3xl gap-10 px-5 py-12 sm:grid-cols-3">
    <div>
      <a href="/" class="flex items-center gap-2 transition-opacity hover:opacity-80" aria-label="SHUBIN vc — home">
        <Arrow class="h-5 w-5" />
        <span class="flex items-baseline gap-[2px] leading-none">
          <span class="font-sans text-[1.05rem] font-extrabold tracking-[-0.01em]">SHUBIN</span>
          <span class="font-sans text-[0.55rem] font-bold lowercase text-muted">vc</span>
        </span>
      </a>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        Startups, product and AI — with numbers, no fluff.
      </p>
    </div>
    <nav aria-label="Footer navigation">
      <p class="meta-label">Site</p>
      <ul class="mt-3 space-y-2 text-sm">
        {NAV.map(({ label, href }) => (
          <li><a class="link-underline text-muted hover:text-ink" href={href}>{label}</a></li>
        ))}
        <li><a class="link-underline text-muted hover:text-ink" href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
    <div>
      <p class="meta-label">Get in touch</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="link-underline text-muted hover:text-ink" href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a></li>
        {AUTHOR.socials.map(({ label, url }) => (
          <li><a class="link-underline text-muted hover:text-ink" href={url} rel="me noopener" target="_blank">{label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t line">
    <p class="mx-auto max-w-3xl px-5 py-5 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted">
      © {year} {AUTHOR.name} · shubin.vc
    </p>
  </div>
</footer>
