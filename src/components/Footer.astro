---
import { AUTHOR, NAV, SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t line">
  <div class="mx-auto grid max-w-3xl gap-10 px-5 py-12 sm:grid-cols-3">
    <div>
      <p class="font-serif text-lg font-semibold">{SITE.shortTitle}</p>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        Стартапы, продукт и ИИ — с цифрами и без воды.
      </p>
    </div>
    <nav aria-label="Навигация в подвале">
      <p class="meta-label">Сайт</p>
      <ul class="mt-3 space-y-2 text-sm">
        {NAV.map(({ label, href }) => (
          <li><a class="link-underline text-muted hover:text-ink" href={href}>{label}</a></li>
        ))}
        <li><a class="link-underline text-muted hover:text-ink" href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
    <div>
      <p class="meta-label">Связаться</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="link-underline text-muted hover:text-ink" href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a></li>
        {AUTHOR.socials.map(({ label, url }) => (
          <li><a class="link-underline text-muted hover:text-ink" href={url} rel="me noopener" target="_blank">{label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t line">
    <p class="mx-auto max-w-3xl px-5 py-5 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted">
      © {year} {AUTHOR.name} · shubin.vc
    </p>
  </div>
</footer>
