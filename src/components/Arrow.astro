---
// The SHUBIN.vc brand mark: a sharp two-tone right arrow.
// Silhouette echoes the master logo's split construction; colors come from
// the site palette — ink (theme-adaptive) + the green highlighter accent.
interface Props {
  class?: string;
}
const { class: cls = 'h-5 w-5' } = Astro.props;
---

<svg class={cls} viewBox="0 0 100 100" aria-hidden="true">
  <polygon points="0,22 60,22 100,50 24,50" fill="currentColor"></polygon>
  <polygon points="24,50 100,50 60,78 0,78" fill="rgb(var(--c-accent-ink))"></polygon>
</svg>
