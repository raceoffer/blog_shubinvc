---
import Base from '../layouts/Base.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { AUTHOR, SITE } from '../consts';

// Schema.org Person — the expert "passport" for GEO (a unified author graph).
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR.name,
  alternateName: AUTHOR.nameNative,
  jobTitle: AUTHOR.role,
  description: AUTHOR.bio,
  url: `${SITE.url}/about`,
  image: `${SITE.url}/nik-shubin.jpg`,
  email: `mailto:${AUTHOR.email}`,
  sameAs: AUTHOR.socials.map((s) => s.url),
  knowsAbout: ['startups', 'venture capital', 'product management', 'artificial intelligence'],
};
---

<Base
  title="About Nik"
  description={`${AUTHOR.name} — investor and private markets professional: deep tech, AI, infrastructure. Bio, talks, contacts and press kit.`}
  jsonLd={personLd}
>
  <section class="mx-auto max-w-3xl px-5 pt-12 sm:pt-16">
    <p class="meta-label">About Nik</p>

    <div class="mt-6 flex flex-col gap-8 sm:flex-row sm:items-start">
      <figure class="shrink-0">
        <img
          src="/nik-shubin.jpg"
          alt={`${AUTHOR.name} — portrait`}
          width="224"
          height="255"
          class="w-48 border line object-cover sm:w-56"
          loading="eager"
          decoding="async"
        />
      </figure>
      <div>
        <h1 class="font-serif text-[2.4rem] font-semibold leading-[1.1] tracking-tight sm:text-[3rem]">
          {AUTHOR.name}
        </h1>
        <p class="mt-3 text-xl leading-relaxed text-muted">
          Investor and private markets professional. Investment Partner at Dealmakers Syndicate.
        </p>
      </div>
    </div>

    <div class="prose mt-12">
      <p>
        Nik Shubin is an investor and private markets professional focused on deep tech,
        artificial intelligence, infrastructure, energy, advanced manufacturing, and other
        complex, high-growth industries. He works with U.S. venture syndicates across the
        investment process — researching companies and markets, conducting due diligence,
        evaluating deal structures, preparing investment materials, and working alongside
        GPs on investor presentations and transaction execution.
      </p>
      <p>
        Nik is an Investment Partner at Dealmakers Syndicate and has spent nearly two decades
        working in finance and investment management. His work spans late-stage and
        growth-stage private technology companies, with a particular interest in businesses
        built around difficult technical problems, large capital requirements, and rapidly
        evolving markets.
      </p>
      <p>
        On this site, Nik writes about private companies, markets, valuations, investment
        cases, and how private-market investing works in practice. His research focuses on
        the questions that matter when evaluating an investment: what is actually driving
        the business, how durable the opportunity is, where the risks are, and whether the
        potential return justifies the price.
      </p>

      <h2>What I write about</h2>
      <ul>
        <li><strong>Startups</strong> — building a company: hiring, sales, mistakes, pivots.</li>
        <li><strong>Product</strong> — metrics, retention, unit economics, product decisions.</li>
        <li><strong>Artificial intelligence</strong> — what actually works in business vs. what's hype.</li>
        <li><strong>Venture</strong> — how investors think, term sheets, rounds, cap tables.</li>
      </ul>

      <h2>Formats</h2>
      <p>
        Short "one idea — one chart" posts come out almost weekly. Once a month — a long essay.
        Once a quarter — a big research piece with open data you can cite (for example, the
        <a href="/research">annual market overview</a>).
      </p>

      <h2>Talks and media</h2>
      <p>
        I speak at industry conferences, run workshops for accelerators and comment on tech
        trends in the media. For speaking or interview requests, email
        <a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>.
      </p>

      <h2>Contacts</h2>
      <p>
        Write to <a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>. Profiles: {' '}
        {AUTHOR.socials.map((s, i) => (
          <>
            <a href={s.url} rel="me noopener" target="_blank">{s.label}</a>{i < AUTHOR.socials.length - 1 ? ' · ' : ''}
          </>
        ))}
      </p>
    </div>

    <div class="mt-16">
      <SubscribeForm compact />
    </div>
  </section>
</Base>
