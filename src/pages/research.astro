---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, getTopics } from '../utils/posts';

const posts = (await getPosts()).filter((p) => p.data.research);
const topics = await getTopics();
---

<Base
  title="Исследования"
  description="Флагманские исследования Ника Шубина: обзоры рынков, рейтинги и открытые данные, которые можно цитировать."
>
  <section class="mx-auto max-w-3xl px-5 pt-12 sm:pt-16">
    <p class="meta-label">Исследования</p>
    <h1 class="mt-4 font-serif text-[2.4rem] font-semibold leading-[1.1] tracking-tight sm:text-[3rem]">
      Большие исследования
    </h1>
    <div class="prose mt-6">
      <p>
        Раз в квартал я публикую флагманский материал: обзор рынка, рейтинг или исследование
        с открытыми данными. Все данные можно цитировать со ссылкой на shubin.vc — именно для
        этого эти материалы и существуют.
      </p>
    </div>

    <div class="mt-12">
      {posts.length > 0 ? (
        posts.map((post) => <PostCard post={post} topics={topics} />)
      ) : (
        <p class="text-muted">Первое исследование готовится — подпишитесь, чтобы не пропустить.</p>
      )}
    </div>
  </section>
</Base>
