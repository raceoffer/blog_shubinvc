---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, getTopics } from '../utils/posts';

const posts = (await getPosts()).filter((p) => p.data.research);
const topics = await getTopics();
---

<Base
  title="Research"
  description="Nick Shubin's flagship research: market overviews, rankings and open data you can cite."
>
  <section class="mx-auto max-w-3xl px-5 pt-12 sm:pt-16">
    <p class="meta-label">Research</p>
    <h1 class="mt-4 font-serif text-[2.4rem] font-semibold leading-[1.1] tracking-tight sm:text-[3rem]">
      Big research pieces
    </h1>
    <div class="prose mt-6">
      <p>
        Once a quarter I publish a flagship piece: a market overview, a ranking or a study
        with open data. Everything can be cited with a link to shubin.vc — that's exactly
        what these pieces are for.
      </p>
    </div>

    <div class="mt-12">
      {posts.length > 0 ? (
        posts.map((post) => <PostCard post={post} topics={topics} />)
      ) : (
        <p class="text-muted">The first study is in the works — subscribe so you don't miss it.</p>
      )}
    </div>
  </section>
</Base>
