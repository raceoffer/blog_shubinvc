---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import Arrow from '../components/Arrow.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { formatDate, getPosts, getTopics, postsByTopic, readingTime } from '../utils/posts';

const posts = await getPosts();
const topics = await getTopics();
// Lead story: the featured piece, or the latest one if none is flagged.
const lead = posts.find((p) => p.data.featured) ?? posts[0];
const leadTopic = topics.find((t) => t.id === lead.data.topic);
const feed = posts.filter((p) => p !== lead).slice(0, 8);
---

<Base>
  {/* Lead story — the featured article in full detail. */}
  <section class="mx-auto max-w-3xl px-5 pt-14 sm:pt-20">
    <p class="meta-label">Nik Shubin — on startups, product & <span class="marker">AI</span></p>

    <article class="mt-10">
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
        {
          leadTopic && (
            <a
              href={`/topics/${leadTopic.id}`}
              class="meta-label text-accentink underline-offset-4 hover:underline"
            >
              {leadTopic.data.title}
            </a>
          )
        }
        <span class="meta-label">{formatDate(lead.data.pubDate)}</span>
        <span class="meta-label">{readingTime(lead.body ?? '')} min read</span>
        {lead.data.research && <span class="meta-label text-accentink">Research</span>}
      </div>

      <h1 class="mt-5 font-serif text-[2.4rem] font-semibold leading-[1.1] tracking-tight sm:text-[3.2rem]">
        <a href={`/blog/${lead.id}`} class="transition-opacity hover:opacity-75">
          {lead.data.title}
        </a>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{lead.data.description}</p>

      {
        lead.data.tldr && (
          <ul
            class="mt-7 space-y-2.5 border-l-[3px] pl-5"
            style="border-color: rgb(var(--c-accent))"
          >
            {lead.data.tldr.slice(0, 4).map((item) => (
              <li class="text-[1.02rem] leading-relaxed">{item}</li>
            ))}
          </ul>
        )
      }

      <a href={`/blog/${lead.id}`} class="btn-accent mt-9 inline-flex items-center gap-2.5">
        Read the piece
        <Arrow class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5" />
      </a>
    </article>
  </section>

  {/* The rest of the feed. */}
  <section class="mx-auto max-w-3xl px-5 pt-24">
    <div class="mb-6 flex items-baseline justify-between">
      <SectionLabel>More posts</SectionLabel>
      <a href="/blog" class="link-underline font-mono text-[0.75rem] uppercase tracking-[0.12em] text-muted hover:text-ink">
        Full archive →
      </a>
    </div>
    <div>
      {feed.map((post, i) => <PostCard post={post} topics={topics} eager={i === 0} />)}
    </div>
  </section>

  {/* Pillar topics. */}
  <section class="mx-auto max-w-3xl px-5 pt-20">
    <SectionLabel class="mb-4">Topics</SectionLabel>
    <ul class="divide-y divide-transparent border-t line">
      {
        topics.map((topic) => {
          const count = postsByTopic(posts, topic.id).length;
          return (
            <li class="border-b line">
              <a href={`/topics/${topic.id}`} class="group flex items-baseline justify-between gap-4 py-4">
                <span class="font-serif text-xl font-medium transition-colors group-hover:text-accentink">
                  {topic.data.title}
                </span>
                <span class="meta-label">{count} posts</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  {/* Subscription — the central CTA. */}
  <section class="mx-auto max-w-3xl px-5 pt-20">
    <SubscribeForm />
  </section>
</Base>
