---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { AUTHOR } from '../consts';
import { getPosts, getTopics, postsByTopic } from '../utils/posts';

const posts = await getPosts();
const topics = await getTopics();
const featured = posts.filter((p) => p.data.featured).slice(0, 1);
const feed = posts.filter((p) => !featured.includes(p)).slice(0, 8);
---

<Base>
  {/* Первый экран: кто такой Ник + подписка (паттерн Gil/Turck). */}
  <section class="mx-auto max-w-3xl px-5 pt-16 sm:pt-24">
    <p class="meta-label">{AUTHOR.role}</p>
    <h1 class="mt-4 font-serif text-[2.6rem] font-semibold leading-[1.08] tracking-tight sm:text-[3.4rem]">
      Ник Шубин. Пишу о&nbsp;стартапах, продукте и&nbsp;<span class="marker">ИИ</span> — с&nbsp;цифрами.
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
      {AUTHOR.bio} Здесь — длинные эссе, короткие разборы с графиками и большие исследования рынков.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href="/newsletter" class="btn-primary">Получать рассылку</a>
      <a href="/about" class="btn-secondary">О Нике</a>
    </div>
  </section>

  {/* Флагманский материал (паттерн Turck). */}
  {
    featured.length > 0 && (
      <section class="mx-auto max-w-3xl px-5 pt-20">
        <p class="meta-label mb-4">Флагманское исследование</p>
        <a
          href={`/blog/${featured[0].id}`}
          class="block border line bg-surface p-8 transition-colors hover:border-muted sm:p-10"
        >
          <p class="meta-label text-accentink">
            {topics.find((t) => t.id === featured[0].data.topic)?.data.title}
          </p>
          <h2 class="mt-3 font-serif text-2xl font-semibold leading-snug sm:text-3xl">
            {featured[0].data.title}
          </h2>
          <p class="mt-3 leading-relaxed text-muted">{featured[0].data.description}</p>
          <span class="link-underline mt-5 inline-block font-mono text-[0.75rem] uppercase tracking-[0.12em]">
            Читать исследование →
          </span>
        </a>
      </section>
    )
  }

  {/* Лента эссе (паттерн Evans). */}
  <section class="mx-auto max-w-3xl px-5 pt-20">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="meta-label">Свежие посты</h2>
      <a href="/blog" class="link-underline font-mono text-[0.75rem] uppercase tracking-[0.12em] text-muted hover:text-ink">
        Весь архив →
      </a>
    </div>
    <div>
      {feed.map((post, i) => <PostCard post={post} topics={topics} eager={i === 0} />)}
    </div>
  </section>

  {/* Рубрики-«столпы». */}
  <section class="mx-auto max-w-3xl px-5 pt-20">
    <h2 class="meta-label mb-4">Темы</h2>
    <ul class="divide-y divide-transparent border-t line">
      {
        topics.map((topic) => {
          const count = postsByTopic(posts, topic.id).length;
          return (
            <li class="border-b line">
              <a href={`/topics/${topic.id}`} class="group flex items-baseline justify-between gap-4 py-4">
                <span class="font-serif text-xl font-medium transition-colors group-hover:text-accentink">
                  {topic.data.title}
                </span>
                <span class="meta-label">{count} постов</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  {/* Подписка — центральный CTA. */}
  <section class="mx-auto max-w-3xl px-5 pt-20">
    <SubscribeForm />
  </section>
</Base>
