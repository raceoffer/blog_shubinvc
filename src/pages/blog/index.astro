---
import Base from '../../layouts/Base.astro';
import { getPosts, getTopics, formatDate, readingTime } from '../../utils/posts';

const posts = await getPosts();
const topics = await getTopics();

// Индекс для клиентского поиска — встраивается в страницу, запросов нет.
const searchIndex = posts.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  topic: topics.find((t) => t.id === p.data.topic)?.data.title ?? '',
  topicSlug: p.data.topic,
  tags: p.data.tags,
  date: formatDate(p.data.pubDate),
  iso: p.data.pubDate.toISOString(),
  minutes: readingTime(p.body ?? ''),
  text: (p.body ?? '').replace(/[#*`\[\]()>|-]/g, ' ').replace(/\s+/g, ' ').slice(0, 4000),
}));
---

<Base
  title="Блог"
  description="Архив всех постов: эссе, разборы с цифрами и исследования о стартапах, продукте, ИИ и венчуре."
>
  <section class="mx-auto max-w-3xl px-5 pt-12 sm:pt-16">
    <h1 class="font-serif text-[2.4rem] font-semibold tracking-tight sm:text-[3rem]">Архив</h1>
    <p class="mt-3 max-w-xl leading-relaxed text-muted">
      Все посты: от коротких разборов «одна мысль — один график» до больших исследований.
    </p>

    {/* Поиск по архиву (Tunguz: при сотнях постов — must have). */}
    <div class="mt-8">
      <label class="sr-only" for="search">Поиск по постам</label>
      <input
        id="search"
        type="search"
        placeholder="Поиск по заголовкам и тексту…"
        autocomplete="off"
        class="w-full rounded-full border bg-surface px-6 py-3.5 text-[1rem] outline-none transition-colors placeholder:text-muted focus:border-muted"
        style="border-color: rgb(var(--c-line) / 0.25)"
      />
    </div>

    {/* Фильтр по рубрикам */}
    <div class="mt-5 flex flex-wrap gap-2" id="topic-filters">
      <button data-topic="" class="filter-btn meta-label rounded-full border px-4 py-2 transition-colors" style="border-color: rgb(var(--c-text) / 0.6)">Все</button>
      {
        topics.map((t) => (
          <button data-topic={t.id} class="filter-btn meta-label rounded-full border px-4 py-2 transition-colors" style="border-color: rgb(var(--c-line) / 0.2)">
            {t.data.title}
          </button>
        ))
      }
    </div>

    <p id="search-status" class="meta-label mt-8" role="status"></p>
    <div id="results" class="mt-2"></div>

    <script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} />
  </section>
</Base>

<script>
  const index = JSON.parse(document.getElementById('search-index')!.textContent!);
  const results = document.getElementById('results')!;
  const status = document.getElementById('search-status')!;
  const input = document.getElementById('search') as HTMLInputElement;
  const filterBtns = [...document.querySelectorAll<HTMLButtonElement>('.filter-btn')];
  let activeTopic = '';

  // ?q= из SearchAction (Schema.org) — сразу применяем запрос.
  const params = new URLSearchParams(location.search);
  if (params.get('q')) input.value = params.get('q')!;

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function render() {
    const q = input.value.trim().toLowerCase();
    const terms = q.split(/\s+/).filter(Boolean);
    const filtered = index.filter(
      (p: any) =>
        (!activeTopic || p.topicSlug === activeTopic) &&
        terms.every((t) => `${p.title} ${p.description} ${p.tags.join(' ')} ${p.text}`.toLowerCase().includes(t)),
    );
    status.textContent = q || activeTopic ? `Найдено: ${filtered.length}` : `Всего постов: ${index.length}`;
    results.innerHTML = filtered
      .map(
        (p: any) => `
        <article class="group border-b line py-7">
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <a href="/topics/${p.topicSlug}" class="meta-label text-accentink hover:underline underline-offset-4">${esc(p.topic)}</a>
            <time class="meta-label" datetime="${p.iso}">${esc(p.date)}</time>
            <span class="meta-label">${p.minutes} мин</span>
          </div>
          <h3 class="mt-2.5 font-serif text-[1.55rem] font-semibold leading-snug tracking-tight">
            <a href="/blog/${p.id}" class="transition-colors group-hover:text-accentink">${esc(p.title)}</a>
          </h3>
          <p class="mt-2 leading-relaxed text-muted">${esc(p.description)}</p>
        </article>`,
      )
      .join('');
    if (filtered.length === 0) {
      results.innerHTML = `<p class="py-10 text-muted">Ничего не найдено. Попробуйте другой запрос или <a class="link-underline" href="/blog">сбросьте фильтры</a>.</p>`;
    }
  }

  input.addEventListener('input', render);
  filterBtns.forEach((btn) =>
    btn.addEventListener('click', () => {
      activeTopic = btn.dataset.topic ?? '';
      filterBtns.forEach((b) => (b.style.borderColor = b === btn ? 'rgb(var(--c-text) / 0.6)' : 'rgb(var(--c-line) / 0.2)'));
      render();
    }),
  );
  render();
</script>
