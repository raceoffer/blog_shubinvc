---
import Base from '../layouts/Base.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { NEWSLETTER } from '../consts';
import { getPosts } from '../utils/posts';

const posts = (await getPosts()).slice(0, 6);
---

<Base
  title="Newsletter"
  description={`${NEWSLETTER.name}: ${NEWSLETTER.pitch}`}
>
  <section class="mx-auto max-w-3xl px-5 pt-12 sm:pt-16">
    <p class="meta-label">Newsletter</p>
    <h1 class="mt-4 font-serif text-[2.4rem] font-semibold leading-[1.1] tracking-tight sm:text-[3rem]">
      {NEWSLETTER.name}
    </h1>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">
      {NEWSLETTER.pitch}
    </p>

    <div class="mt-10">
      <SubscribeForm />
    </div>

    <div class="prose mt-14">
      <h2>How it works</h2>
      <ul>
        <li>One email a week — a digest of new posts plus notes that never make it to the site.</li>
        <li>Email-confirmed subscription (double opt-in) — no spam, ever.</li>
        <li>One-click unsubscribe; your data is never shared with third parties.</li>
        <li>There's a <a href="/rss.xml">full-text RSS feed</a> — for those who read in aggregators.</li>
      </ul>

      <h2>Latest posts — what you're subscribing to</h2>
    </div>

    <ul class="mt-4 divide-y divide-transparent border-t line">
      {
        posts.map((p) => (
          <li class="border-b line">
            <a href={`/blog/${p.id}`} class="group flex items-baseline justify-between gap-4 py-4">
              <span class="font-serif text-lg font-medium leading-snug transition-colors group-hover:text-accentink">
                {p.data.title}
              </span>
              <time class="meta-label shrink-0" datetime={p.data.pubDate.toISOString()}>
                {p.data.pubDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short' })}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
