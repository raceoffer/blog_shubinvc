---
import Base from '../layouts/Base.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { NEWSLETTER } from '../consts';
import { getPosts } from '../utils/posts';

const posts = (await getPosts()).slice(0, 6);
---

<Base
  title="Рассылка"
  description={`${NEWSLETTER.name}: ${NEWSLETTER.pitch}`}
>
  <section class="mx-auto max-w-3xl px-5 pt-12 sm:pt-16">
    <p class="meta-label">Рассылка</p>
    <h1 class="mt-4 font-serif text-[2.4rem] font-semibold leading-[1.1] tracking-tight sm:text-[3rem]">
      {NEWSLETTER.name}
    </h1>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">
      {NEWSLETTER.pitch}
    </p>

    <div class="mt-10">
      <SubscribeForm />
    </div>

    <div class="prose mt-14">
      <h2>Как это устроено</h2>
      <ul>
        <li>Одно письмо в неделю — дайджест новых постов + заметки, которых нет на сайте.</li>
        <li>Подтверждение подписки по email (double opt-in) — никакого спама.</li>
        <li>Отписка в один клик, ваши данные не передаются третьим лицам.</li>
        <li>Есть <a href="/rss.xml">RSS-фид полного текста</a> — для тех, кто читает в агрегаторах.</li>
      </ul>

      <h2>Последние посты — за что подписываются</h2>
    </div>

    <ul class="mt-4 divide-y divide-transparent border-t line">
      {
        posts.map((p) => (
          <li class="border-b line">
            <a href={`/blog/${p.id}`} class="group flex items-baseline justify-between gap-4 py-4">
              <span class="font-serif text-lg font-medium leading-snug transition-colors group-hover:text-accentink">
                {p.data.title}
              </span>
              <time class="meta-label shrink-0" datetime={p.data.pubDate.toISOString()}>
                {p.data.pubDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' })}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
